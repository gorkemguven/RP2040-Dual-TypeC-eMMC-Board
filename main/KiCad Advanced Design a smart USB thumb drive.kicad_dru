(version 1)

(rule "IC601 via-in-pad size"
	(constraint via_diameter (min 0.3mm))
	(constraint hole_size (min 0.15mm))
	(condition "A.insideCourtyard('IC601')")
)

(rule "IC601 via-in-pad clearance"
	(constraint clearance (min 0mm))
	(condition "A.Type == 'Via' && A.insideCourtyard('IC601') && B.Type == 'Pad' && B.memberOfFootprint('IC601')")
)
